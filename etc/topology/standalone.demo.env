# Isolated demo environment (standalone.demo).
# Independent database schema: sdkwork_image_demo
# Independent Redis prefix: image-demo (logical DB index 9) to avoid sharing conflicts on a shared Redis.
SDKWORK_IMAGE_DEPLOYMENT_PROFILE=standalone
SDKWORK_IMAGE_ENVIRONMENT=demo
SDKWORK_IMAGE_PROFILE_ID=standalone.demo
SDKWORK_IMAGE_APPLICATION_PUBLIC_HTTP_URL=https://image-demo.sdkwork.com
SDKWORK_IMAGE_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3900


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_IMAGE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://image-demo.sdkwork.com,http://image-demo.sdkwork.com,https://image-demo.birdcoder.com,http://image-demo.birdcoder.com,https://image-demo.dtupay.com,http://image-demo.dtupay.com,https://image-demo.noaper.com,http://image-demo.noaper.com,https://image-demo.sdkwork.cn,http://image-demo.sdkwork.cn,https://image-demo.birdcoder.cn,http://image-demo.birdcoder.cn,https://image-demo.dtupay.cn,http://image-demo.dtupay.cn,https://image-demo.noaper.cn,http://image-demo.noaper.cn,https://image-demo.skubc.com,http://image-demo.skubc.com,https://image-demo.skubc.cn,http://image-demo.skubc.cn,https://image-demo.zowalk.com,http://image-demo.zowalk.com,https://image-demo.zowalk.cn,http://image-demo.zowalk.cn,https://image-demo.offer86.com,http://image-demo.offer86.com,https://image-demo.offer86.cn,http://image-demo.offer86.cn,https://image-demo.86offer.com,http://image-demo.86offer.com,https://image-demo.86offer.cn,http://image-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
