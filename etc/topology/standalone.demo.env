# Isolated demo environment (standalone.demo).
# Independent database schema: sdkwork_image_demo
# Independent Redis prefix: image-demo (logical DB index 9) to avoid sharing conflicts on a shared Redis.
SDKWORK_IMAGE_DEPLOYMENT_PROFILE=standalone
SDKWORK_IMAGE_ENVIRONMENT=demo
SDKWORK_IMAGE_PROFILE_ID=standalone.demo
SDKWORK_IMAGE_APPLICATION_PUBLIC_HTTP_URL=https://image-demo.sdkwork.com
