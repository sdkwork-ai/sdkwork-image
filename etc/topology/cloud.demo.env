# Isolated demo environment (cloud.demo).
# Independent database schema: sdkwork_image_demo
# Independent Redis prefix: image-demo (logical DB index 9) to avoid sharing conflicts on a shared Redis.
SDKWORK_IMAGE_DEPLOYMENT_PROFILE=cloud
SDKWORK_IMAGE_ENVIRONMENT=demo
SDKWORK_IMAGE_PROFILE_ID=cloud.demo
SDKWORK_IMAGE_APPLICATION_PUBLIC_HTTP_URL=https://image-demo.sdkwork.com
SDKWORK_IMAGE_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_IMAGE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
