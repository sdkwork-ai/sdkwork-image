# Bootstrap profile standalone.staging — replace with application-specific values.
SDKWORK_IMAGE_DEPLOYMENT_PROFILE=standalone
SDKWORK_IMAGE_ENVIRONMENT=staging
SDKWORK_IMAGE_PROFILE_ID=standalone.staging
SDKWORK_IMAGE_APPLICATION_PUBLIC_HTTP_URL=https://image-staging.sdkwork.com
SDKWORK_IMAGE_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3900


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_IMAGE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
